  "semanticTokenColors": {
    "namespace": "#D0AA70",
    "type": "#D0AA70",
    "class": "#D0AA70",
    "enum": "#D0AA70",
    "interface": "#D0AA70",
    "struct": "#D0AA70",
    "typeParameter": "#C9926D",
    "parameter": "#C4C7C6",
    "variable": "#C4C7C6",
    "variable.readonly": "#C9926D",
    "property": "#C4C7C6",
    "property.readonly": "#C9926D",
    "enumMember": "#C9926D",
    "decorator": "#B39AC9",
    "event": "#B39AC9",
    "function": "#83A9C9",
    "method": "#83A9C9",
    "macro": "#B39AC9",
    "label": "#D6A567",
    "comment": "#888D92",
    "string": "#91AF7D",
    "number": "#C9926D",
    "regexp": "#7FAFB2",
    "keyword": "#C98282",
    "operator": "#858A8F"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#888D92"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C98282"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#83A9C9"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#D0AA70"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#91AF7D"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#C9926D"
      }
    },
    {
      "name": "Tags and attributes",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#B39AC9"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "variable.other",
        "support.variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C4C7C6"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#858A8F"
      }
    },
    {
      "name": "Regular expressions and escapes",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7FAFB2"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#83A9C9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown heading punctuation",
      "scope": "punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#5F6468"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "foreground": "#D0D2D1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic.markdown",
      "settings": {
        "foreground": "#C8CBCA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw.string.markdown",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#D6A567"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link.markdown",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#8FB5D5"
      }
    },
    {
      "name": "Markdown link destinations",
      "scope": [
        "markup.underline.link.image.markdown",
        "meta.link.inline.markdown string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#91AF7D"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": "markup.quote.markdown",
      "settings": {
        "foreground": "#888D92",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list punctuation",
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#83A9C9"
      }
    }
  ]
}
