{
  "name": "minimal-theme",
  "displayName": "Damln Minimal Theme",
  "description": "Quiet dark and light color themes for standard VS Code.",
  "version": "0.7.1",
  "publisher": "damln",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:damlnMinimalTheme.createSkill"
  ],
  "scripts": {
    "check": "node --check extension.js && node --check create-skill.js",
    "test": "node --test ../../tests/create-skill.test.js"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "damln",
    "dark",
    "minimal",
    "theme",
    "light"
  ],
  "files": [
    "extension.js",
    "create-skill.js",
    "README.md",
    "themes/minimal-color-theme.json",
    "LICENSE",
    "icon.svg",
    "icon.png",
    "themes/minimal-light-color-theme.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "damlnMinimalTheme.createSkill",
        "title": "Create Skill",
        "category": "Damln"
      }
    ],
    "themes": [
      {
        "label": "Damln Minimal",
        "uiTheme": "vs-dark",
        "path": "./themes/minimal-color-theme.json"
      },
      {
        "label": "Damln Minimal Light",
        "uiTheme": "vs",
        "path": "./themes/minimal-light-color-theme.json"
      }
    ]
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/damln/vscode.git",
    "directory": "extensions/minimal-theme"
  }
}
