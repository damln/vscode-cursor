{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "inline-code-boundary.js",
    "jump-model.js",
    "link-range.js",
    "markdown-model.js",
    "toolbar-visibility.js"
  ]
}
