{
  "name": "file-actions",
  "displayName": "Damln File Actions",
  "description": "Copy content, file paths and parent folder paths from every editor title bar.",
  "version": "0.1.2",
  "publisher": "damln",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./extension.js",
  "files": [
    "README.md",
    "extension.js"
  ],
  "contributes": {
    "commands": [
      {
        "command": "damlnFileActions.copyContent",
        "title": "Copy full file content to clipboard",
        "category": "File",
        "icon": "$(copy)",
        "enablement": "resource"
      },
      {
        "command": "damlnFileActions.copyFilePath",
        "title": "Copy file path relative to workspace",
        "category": "File",
        "icon": "$(file-code)",
        "enablement": "resource && resourceScheme != untitled"
      },
      {
        "command": "damlnFileActions.copyParentFolderPath",
        "title": "Copy parent folder path relative to workspace",
        "category": "File",
        "icon": "$(folder)",
        "enablement": "resource && resourceScheme != untitled"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "damlnFileActions.copyContent",
          "when": "resource",
          "group": "navigation@10"
        },
        {
          "command": "damlnFileActions.copyFilePath",
          "when": "resource",
          "group": "navigation@11"
        },
        {
          "command": "damlnFileActions.copyParentFolderPath",
          "when": "resource",
          "group": "navigation@12"
        }
      ],
      "commandPalette": [
        {
          "command": "damlnFileActions.copyContent",
          "when": "resource"
        },
        {
          "command": "damlnFileActions.copyFilePath",
          "when": "resource && resourceScheme != untitled"
        },
        {
          "command": "damlnFileActions.copyParentFolderPath",
          "when": "resource && resourceScheme != untitled"
        }
      ]
    }
  }
}
