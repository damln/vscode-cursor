{
  "name": "html-preview",
  "displayName": "Damln HTML Preview",
  "description": "Open local HTML files in VS Code's built-in Integrated Browser.",
  "version": "0.4.0",
  "publisher": "damln",
  "license": "MIT",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:damlnHtmlPreview.openPreview"
  ],
  "main": "./extension.js",
  "files": [
    "README.md",
    "extension.js",
    "LICENSE",
    "icon.svg",
    "icon.png"
  ],
  "contributes": {
    "commands": [
      {
        "command": "damlnHtmlPreview.openPreview",
        "title": "Open HTML in Integrated Browser",
        "category": "HTML Preview",
        "icon": "$(globe)",
        "enablement": "resourceScheme == file && resourceExtname =~ /\\.html?$/i && isWorkspaceTrusted"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "damlnHtmlPreview.openPreview",
          "when": "resourceScheme == file && resourceExtname =~ /\\.html?$/i"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "HTML files run authored scripts in the built-in browser."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The built-in browser opens local files. Use a forwarded HTTP URL for remote sites."
    }
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/damln/vscode.git",
    "directory": "extensions/html-preview"
  }
}
