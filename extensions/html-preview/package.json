{
  "name": "html-preview",
  "displayName": "Damln HTML Preview",
  "description": "Preview HTML files in a supported VS Code custom editor.",
  "version": "0.3.0",
  "publisher": "damln",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCustomEditor:damln.htmlPreview",
    "onCommand:damlnHtmlPreview.editSource",
    "onCommand:damlnHtmlPreview.openPreview"
  ],
  "main": "./extension.js",
  "files": [
    "README.md",
    "extension.js",
    "preview-html.js",
    "LICENSE",
    "icon.svg",
    "icon.png",
    "navigation.js"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "damln.htmlPreview",
        "displayName": "HTML Preview",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "damlnHtmlPreview.editSource",
        "title": "Edit HTML Source",
        "category": "HTML Preview",
        "icon": "$(edit)"
      },
      {
        "command": "damlnHtmlPreview.openPreview",
        "title": "Open HTML Preview",
        "category": "HTML Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "damlnHtmlPreview.editSource",
          "when": "activeCustomEditorId == damln.htmlPreview",
          "group": "navigation@1"
        },
        {
          "command": "damlnHtmlPreview.openPreview",
          "when": "editorLangId == html && activeCustomEditorId != damln.htmlPreview",
          "group": "navigation@1"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "HTML previews execute authored scripts and load remote resources."
    }
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/damln/vscode.git",
    "directory": "extensions/html-preview"
  }
}
